# Pick ONE provider key. Without any key the app runs in offline mode (PDF text layer + Tesseract OCR).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini            # gemini | anthropic | openai | none  (default: first key found)
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini

# Business rules (defaults shown)
# PRICE_TOLERANCE_PCT=2.0
# AMOUNT_TOLERANCE_PCT=1.0
# AMOUNT_TOLERANCE_ABS=2500
# PAYMENT_TERMS_DAYS=30

# Visual pacing of the live run view (seconds per stage). 0 = as fast as possible.
STAGE_DELAY=0.45
